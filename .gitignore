# Dependencies — these are huge and can always be re-installed from package.json
node_modules/

# Compiled output — generated by `npm run build`, not hand-edited
dist/

# Environment variables — contains real secrets like API keys
.env
docs-hum/
docs-hum/**
# Log files — runtime logs should not be tracked
*.log
npm-debug.log*

# OS-specific files
.DS_Store
Thumbs.db
