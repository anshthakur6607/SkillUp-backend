# ==============================================================================
# Skill Intelligence Backend — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in real values before running the server.
# NEVER commit .env to version control — it contains secrets.
# ==============================================================================

# Application environment: "development" or "production"
# Controls things like error detail visibility and logging verbosity.
NODE_ENV=development

# Port the server listens on. Change this if port 5000 is already in use.
PORT=5000

# Supabase project URL (found in your Supabase dashboard under Settings > API)
SUPABASE_URL=

# Supabase anonymous/public key — used for requests that should respect
# Row Level Security (RLS) policies. Safe to use in client-side code too.
SUPABASE_ANON_KEY=

# SECURITY: Supabase service role key — BYPASSES ALL RLS POLICIES.
# This key has unrestricted database access. Use ONLY for trusted server-side
# operations (e.g. role-checking in requireRole middleware, admin endpoints).
# NEVER expose this to the frontend, log it, or include it in error messages.
# If this key leaks, regenerate it immediately in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of origins allowed to make requests to this API.
# This prevents other websites from making requests on behalf of your users.
# Example: "http://localhost:3000,http://localhost:3001,https://your-domain.gov.in"
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting: time window in milliseconds.
# 900000 ms = 15 minutes. Requests from the same IP are counted within this window.
RATE_LIMIT_WINDOW_MS=900000

# Rate limiting: maximum number of requests allowed per IP within the time window.
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================================================
# Upstash Redis (required for distributed rate limiting & session caching)
# ==============================================================================
# Get these from your Upstash Console: https://console.upstash.com
# 1. Create a new Redis database
# 2. Copy the REST URL and Token
# Without these, the backend falls back to in-memory rate limiting
# (single-instance only — not suitable for multiple Vercel/Cloudflare workers).

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==============================================================================
# AI APIs — MCQ Assessment Generation
# ==============================================================================
# At least ONE of these must be configured for course assessments to work.
# The system randomly picks a model and falls back to the other if it fails.
#
# Gemini (Google AI): https://aistudio.google.com/apikey
# - Free tier: 15 RPM, 1M tokens/day
# - Good at generating educational content
GEMINI_API_KEY=
#
# Sarvam AI: https://sarvam.ai
# - Indian government-backed, good at Indian context
# - API key from https://api.sarvam.ai
SARVAM_API_KEY=
